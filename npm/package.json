{
  "name": "utp-engine",
  "version": "2.6.2",
  "description": "Zero-disk cloud-to-cloud transfer, direct web ingestion, media streaming & sync engine — Google Drive, OneDrive, S3, R2, Dropbox, WebDAV — TLS 1.3 RAM pipeline",
  "main": "./bin/utp.js",
  "bin": {
    "utp": "bin/utp.js",
    "utp-engine": "bin/utp.js",
    "utpd": "bin/utpd.js",
    "utp-server": "bin/utpd.js"
  },
  "files": [
    "bin/launcher.js",
    "bin/utp.js",
    "bin/utpd.js",
    "scripts/install.js",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
