pkgname=utp-bin
pkgver=2.5.0
pkgrel=1
pkgdesc="Universal Cloud Transfer Protocol (UTP) - Direct 0-Disk High-Speed Cloud-to-Cloud Pipeline"
arch=('x86_64' 'aarch64')
url="https://github.com/ARPIT-NAYAK-LEGEND/Cloud-Transfer-Protocol"
license=('MIT')
depends=('curl' 'openssl' 'sqlite')
provides=('utp')
conflicts=('utp')
source_x86_64=("${url}/releases/download/v${pkgver}/utp-linux-x64.tar.gz")
sha256sums_x86_64=('SKIP')

package() {
    install -Dm755 "${srcdir}/utp" "${pkgdir}/usr/bin/utp"
}
