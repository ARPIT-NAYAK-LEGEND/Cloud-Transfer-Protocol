{
  "name": "@utp/client",
  "version": "2.6.1",
  "description": "Universal Cloud Transfer Protocol (UTP) - Native TypeScript / JavaScript Client SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
