  "homepage": "https://ctp.arpitnayak.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARPIT-NAYAK-LEGEND/Cloud-Transfer-Protocol.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/ARPIT-NAYAK-LEGEND/Cloud-Transfer-Protocol/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
